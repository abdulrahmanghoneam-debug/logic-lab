FROM node:20-alpine
WORKDIR /app

COPY package.json ./
COPY index.html LOGIC_LAB_INTERACTIVE_EDITION.html ./
COPY LOGIC_LAB_COLLECTORS_EDITION.pdf LOGIC_LAB_DIGITAL_EDITION.pdf LOGIC_LAB_COVER.pdf PRINTING_GUIDE.txt ./
